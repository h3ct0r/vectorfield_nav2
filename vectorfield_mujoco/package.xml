<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vectorfield_mujoco</name>
  <version>0.4.0</version>
  <description>MuJoCo physics for the vectorfield_nav2 examples: the mujoco_sim node (vectorfield_sim's interface for ground robots, point_sim_3d's for the drone), the example launch files, robot configs and scenarios driving Nav2, the curve follower and the 3D follower, a robot registry (MuJoCo Menagerie robots fetched at a pinned commit, a vendored AgileX Scout Mini and an own Ackermann car), worlds built from Nav2 maps, twist adapters, a quadrotor velocity controller, a 2D lidar, marker overlays and MP4 recording. Source-only: it depends on MuJoCo from pip.</description>
  <maintainer email="hector@dcc.ufmg.br">Héctor Azpúrua</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://h3ct0r.github.io/vectorfield_nav2/</url>
  <url type="repository">https://github.com/h3ct0r/vectorfield_nav2</url>
  <url type="bugtracker">https://github.com/h3ct0r/vectorfield_nav2/issues</url>
  <author email="hector@dcc.ufmg.br">Héctor Azpúrua</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>ffmpeg</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>git</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>libosmesa6-dev</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-mujoco-pip</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>vectorfield_bringup</exec_depend>
  <exec_depend>vectorfield_curve_follower</exec_depend>
  <exec_depend>vectorfield_follower_3d</exec_depend>
  <exec_depend>vectorfield_msgs</exec_depend>
  <exec_depend>vectorfield_nav2_controller</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>vectorfield_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
