# ROS 2 / ament style: identical to ament_lint's
# ament_clang_format/configuration/.clang-format (rolling branch), plus
# IncludeBlocks: Preserve so clang-format never regroups the ROS include order
# (C system, C++ standard, other libraries, this project).
---
Language: Cpp
BasedOnStyle: Google

AccessModifierOffset: -2
AlignAfterOpenBracket: AlwaysBreak
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterEnum: true
BreakBeforeBraces: Custom
ColumnLimit: 100
ConstructorInitializerIndentWidth: 0
ContinuationIndentWidth: 2
DerivePointerAlignment: false
IncludeBlocks: Preserve
PointerAlignment: Middle
ReflowComments: false
...
