<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vectorfield_follower_3d</name>
  <version>0.3.0</version>
  <description>Experimental 3D curve follower for drones and other robots that take a 3D velocity setpoint: a lifecycle component with a FollowCurve3 action server around the vectorfield_core 3D tracker (moving frames, CBF obstacle avoidance against primitives and a voxelised point cloud), and a kinematic point simulator for tests and demos.</description>
  <maintainer email="hector@dcc.ufmg.br">Héctor Azpúrua</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://h3ct0r.github.io/vectorfield_nav2/</url>
  <url type="repository">https://github.com/h3ct0r/vectorfield_nav2</url>
  <url type="bugtracker">https://github.com/h3ct0r/vectorfield_nav2/issues</url>
  <author email="hector@dcc.ufmg.br">Héctor Azpúrua</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>generate_parameter_library</depend>
  <depend>geometry_msgs</depend>
  <depend condition="$ROS_DISTRO != humble and $ROS_DISTRO != jazzy and $ROS_DISTRO != kilted">nav2_ros_common</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vectorfield_core</depend>
  <depend>vectorfield_curve_follower</depend>
  <depend>vectorfield_msgs</depend>
  <depend>vectorfield_ros</depend>
  <depend>visualization_msgs</depend>

  <test_depend>action_msgs</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>lifecycle_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
