{
  "name": "vectorfield_nav2 (rolling: compile + unit tests)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws/src/vectorfield_nav2,type=bind",
  "workspaceFolder": "/ws/src/vectorfield_nav2",
  "mounts": [
    "source=vf-rolling-build,target=/ws/build,type=volume",
    "source=vf-rolling-install,target=/ws/install,type=volume",
    "source=vf-rolling-log,target=/ws/log,type=volume",
    "source=vf-rolling-ccache,target=/ccache,type=volume"
  ],
  "runArgs": ["--shm-size=1g"],
  "init": true,
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "foxglove_bridge",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "CCACHE_DIR": "/ccache",
    "CMAKE_C_COMPILER_LAUNCHER": "ccache",
    "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST"
  },
  "postCreateCommand": [
    "bash",
    "-c",
    ". /opt/ros/rolling/setup.bash && . /root/nav2_ws/install/setup.bash && apt-get update && rosdep update --rosdistro rolling && rosdep install --from-paths /ws/src --ignore-src -y -r --rosdistro rolling --skip-keys \"$VF_ROLLING_SKIP_KEYS navigation2\""
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-pack",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--compile-commands-dir=/ws/build",
          "--background-index",
          "--header-insertion=never"
        ],
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
