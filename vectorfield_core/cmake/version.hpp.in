/// @file
/// @brief Version of vectorfield_core, generated by CMake from package.xml.
///
/// Do not edit the generated header: it is written from cmake/version.hpp.in at configure time,
/// and package.xml is the single source of the version.

#ifndef VECTORFIELD_CORE__VERSION_HPP_
#define VECTORFIELD_CORE__VERSION_HPP_

/// Major version (package.xml).
#define VF_CORE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
/// Minor version (package.xml).
#define VF_CORE_VERSION_MINOR @PROJECT_VERSION_MINOR@
/// Patch version (package.xml).
#define VF_CORE_VERSION_PATCH @PROJECT_VERSION_PATCH@
/// Full version string, "MAJOR.MINOR.PATCH".
#define VF_CORE_VERSION_STR "@PROJECT_VERSION@"

#endif  // VECTORFIELD_CORE__VERSION_HPP_
