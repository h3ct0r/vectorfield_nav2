<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vectorfield_bringup</name>
  <version>0.5.0</version>
  <description>Launch files, Nav2 parameter overlays, maps and RViz, Foxglove and PlotJuggler configurations for running and visualizing the vectorfield_nav2 controller and curve follower in the loopback, kinematic and Gazebo simulations.</description>
  <maintainer email="hector@dcc.ufmg.br">Héctor Azpúrua</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://h3ct0r.github.io/vectorfield_nav2/</url>
  <url type="repository">https://github.com/h3ct0r/vectorfield_nav2</url>
  <url type="bugtracker">https://github.com/h3ct0r/vectorfield_nav2/issues</url>
  <author email="hector@dcc.ufmg.br">Héctor Azpúrua</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend condition="$ROS_DISTRO == humble">rclcpp</depend>
  <depend condition="$ROS_DISTRO == humble">rclcpp_components</depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">nav2_loopback_sim</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">nav2_minimal_tb3_sim</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">nav2_minimal_tb4_sim</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_bridge</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_sim</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>vectorfield_behavior_tree</exec_depend>
  <exec_depend>vectorfield_curve_follower</exec_depend>
  <exec_depend>vectorfield_follower_3d</exec_depend>
  <exec_depend>vectorfield_msgs</exec_depend>
  <exec_depend>vectorfield_nav2_controller</exec_depend>
  <exec_depend>vectorfield_py</exec_depend>
  <exec_depend>vectorfield_sim</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
