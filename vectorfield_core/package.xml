<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vectorfield_core</name>
  <version>0.6.0</version>
  <description>
    ROS-free C++17 core of vectorfield_nav2: constructive time-varying artificial vector fields
    (Rezende, Gonçalves and Pimenta, IEEE T-RO 2022), curve projection, obstacle contouring,
    collision prediction, tracking laws and kinematic integration. Depends only on Eigen and
    builds with ament_cmake or plain CMake.
  </description>
  <maintainer email="hector@dcc.ufmg.br">Héctor Azpúrua</maintainer>
  <license>Apache-2.0</license>
  <license file="third_party/muparser/LICENSE">BSD-2-Clause</license>
  <url type="website">https://h3ct0r.github.io/vectorfield_nav2/</url>
  <url type="repository">https://github.com/h3ct0r/vectorfield_nav2</url>
  <url type="bugtracker">https://github.com/h3ct0r/vectorfield_nav2/issues</url>
  <author email="hector@dcc.ufmg.br">Héctor Azpúrua</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
