# Doxygen produces XML only; Sphinx renders it through Breathe (project vectorfield_core).
# Run from this directory: (cd docs && doxygen Doxyfile). Paths are relative to docs/.
# Settings not listed here keep Doxygen's defaults.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = vectorfield_nav2
PROJECT_BRIEF          = "Constructive time-varying vector fields for Nav2"
OUTPUT_DIRECTORY       = _doxygen
CREATE_SUBDIRS         = NO
INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ../vectorfield_core/include \
                         ../vectorfield_ros/include \
                         ../vectorfield_nav2_controller/include

#---------------------------------------------------------------------------
# Input. Directories that do not exist yet only produce a warning.
#---------------------------------------------------------------------------
INPUT                  = ../vectorfield_core/include \
                         ../vectorfield_ros/include \
                         ../vectorfield_nav2_controller/include
FILE_PATTERNS          = *.hpp \
                         *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */third_party/* \
                         */detail/*

#---------------------------------------------------------------------------
# Preprocessor. Only VF_CANCEL_RESET_OVERRIDE (compat.hpp) is expanded, so
# cancel()/reset() parse identically on every distro.
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = VF_CANCEL_RESET_OVERRIDE=override

#---------------------------------------------------------------------------
# Warnings. WARN_IF_UNDOCUMENTED is enabled once the public headers are
# documented.
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
USE_MATHJAX            = YES
HAVE_DOT               = NO
